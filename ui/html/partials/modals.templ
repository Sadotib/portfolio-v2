package partials

templ Modals() {
	<!-- About Modal -->
	<div id="about" class="modal-overlay">
		<a href="#" class="modal__close" aria-label="Close">&times;</a>
		<div class="modal__content">
			<h2 class="modal__heading">About<br/>the Studio</h2>
			<p class="modal__text"><strong>Compression</strong> is a design practice built on the belief that the best work happens under constraints. We take complex problems and compress them into clear, decisive systems.</p>
			<p class="modal__text">Founded in 2020, the studio operates at the intersection of architecture, digital product, and visual identity. Our process is reductive — we strip away until only the essential remains.</p>
			<hr class="modal__divider"/>
			<p class="modal__text"><strong>Capabilities</strong><br/>Brand Identity / Art Direction / UI &amp; UX Design / Motion Systems / Architectural Visualization / Digital Products / Creative Technology</p>
			<hr class="modal__divider"/>
			<p class="modal__text">This is a free HTML CSS template from <a href="https://templatemo.com/tm-620-compression" target="_blank" rel="nofollow">TemplateMo</a>. You are free to download, edit, and use this template for any purpose. Images are from <a href="https://unsplash.com/" target="_blank">Unsplash</a>.</p>
		</div>
	</div>
	<!-- Contact Modal -->
	<div id="contact" class="modal-overlay">
		<a href="#" class="modal__close" aria-label="Close">&times;</a>
		<div class="modal__content">
			<h2 class="modal__heading">Get In<br/>Touch</h2>
			<p class="modal__text">Currently accepting select projects for Q3 2026. For inquiries, collaborations, or just to talk shop — reach out through any channel below.</p>
			<hr class="modal__divider"/>
			<div class="modal__contact-grid">
				<div class="modal__contact-item">
					<p class="modal__contact-label">Email</p>
					<p class="modal__contact-value"><a href="mailto:hello@compression.studio">hello@compression.studio</a></p>
				</div>
				<div class="modal__contact-item">
					<p class="modal__contact-label">Phone</p>
					<p class="modal__contact-value"><a href="tel:+1234567890">+1 (234) 567-890</a></p>
				</div>
				<div class="modal__contact-item">
					<p class="modal__contact-label">Social</p>
					<p class="modal__contact-value"><a href="#">compression.studio</a></p>
				</div>
				<div class="modal__contact-item">
					<p class="modal__contact-label">Location</p>
					<p class="modal__contact-value">Brooklyn, NY</p>
				</div>
			</div>
		</div>
	</div>
}
