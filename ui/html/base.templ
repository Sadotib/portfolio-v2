package html

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Favicon & Meta -->
			<meta name="description" content="Bitopan Das | Portfolio"/>
			<meta name="theme-color" content="#050508"/>
			<link rel="shortcut icon" href="/static/img/favicon.ico" type="image/x-icon" />
			<!-- Google Fonts -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			// <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
			<link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Orbitron:wght@500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
			<!-- Application Stylesheet -->
			<link rel="stylesheet" href="/static/css/main.css"/>
			<!-- HTMX & HTMX SSE Extension -->
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmzkRlChUPperxmnhBhq6LS5DpCX9LiqGqoZO2b" crossorigin="anonymous"></script>
			<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
		</head>
		<body class="pda-app">
			<main id="main-content" class="pda-device">
				<div class="device-top-strip" aria-hidden="true">
					<span class="antenna"></span>
					<span class="device-mark">PDA-7X FIELD DATAPAD</span>
					// <span class="top-leds"><i></i><i></i><i></i></span>
				</div>
				<div class="device-frame">
					<aside class="device-panel device-panel-left" aria-hidden="true">
						<span class="screw screw-a"></span>
						<span class="screw screw-b"></span>
						
						
						
						<button
							id="music-toggle"
							class="music-toggle"
							type="button"
							aria-label="Toggle ambient audio"
							title="Toggle ambient audio">

							<span class="music-icon" aria-hidden="true">◖) )</span>

							<span class="music-led led-red"></span>
						</button>

						<button
							id="power-button"
							class="power-button"
							type="button"
							aria-label="Power PDA on or off"
							title="Power">

							<span class="power-symbol">⏻</span>
						</button>
						<div id="volume-wheel" class="volume-wheel" role="slider" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
							<span class="wheel-notch"></span>
							<span class="wheel-label">VOL</span>
						</div>
						// <div class="panel-leds"><i></i><i></i><i></i></div>
					</aside>
					<section class="pda-screen" aria-label="PDA portfolio screen">
						{ children... }
					</section>
					<aside class="device-panel device-panel-right">
						
						<span class="screw screw-d"></span>
						
					</aside>
				</div>
				<div class="device-bottom-strip" aria-hidden="true"><span>MODEL: SD-7X-042</span><span>CAUTION HANDLE WITH CURIOSITY</span><span>SN: 00-7X-2026</span></div>
			</main>
			<audio id="bg-music" src="/static/audio/music.mp3" loop></audio>
			<script src="/static/js/pda.js"></script>
		</body>
	</html>
}
