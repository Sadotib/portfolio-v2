package pages

import "portfolio-v2/ui/html"

templ Projects() {
	@html.Base() {
		<!-- ============ SLIDE 4 : Projects ============ -->
		<section class="slide s-lime" data-slide="3">
			<div class="inner scrollable">
				<div class="wrap">
					// <span class="kicker hl-orange" data-reveal>05 / Press</span>
					<h2 class="big" data-reveal style="margin:6px 0 16px">Projects</h2>
					<div class="quote-grid">
						<div class="quote" data-reveal>
							<a href="https://github.com/Sadotib/disaster-recovery-daemon" target="_blank" class="mk"> ↗ </a>
							<p>Desktop Session Restoration Daemon for Linux Systems</p>
							<span class="src">Go · Linux · JSON · Electron</span>
						</div>
						
						<div class="quote" data-reveal>
							<a href="https://github.com/Sadotib/cloud-games" target="_blank" class="mk"> ↗ </a>
							<p>Cloud Games – Multiplayer Browser Games</p>
							<span class="src">Go · Websockets · Javascript · AWS</span>
							// <span>https:/</span>
						</div>
						<div class="quote" data-reveal>
							<a href="https://github.com/Sadotib/burd" target="_blank" class="mk"> ↗ </a>
							<p>Burd - AI Driven Bird Identification</p>
							<span class="src">Flutter · ML(Python) · Flask</span>
						</div>
						<div class="quote" data-reveal>
							<a href="https://github.com/Sadotib/yesfix-site" target="_blank" class="mk"> ↗ </a>
							<p>YesFix Website</p>
							<span class="src">Go · HTMX · Postgres</span>
						</div>
						<div class="quote" data-reveal>
							<a href="https://github.com/Sadotib/snippetbox" target="_blank" class="mk"> ↗ </a>
							<p>Snippetbox - Paste and share snippets of text</p>
							<span class="src">Go · MySQL</span>
						</div>
						// <div class="quote" data-reveal>
						// 	<span class="mk">"</span>
						// 	<p>Genuinely impossible to listen to quietly.</p>
						// 	<span class="src">Static Zine</span>
						// </div>
					</div>
				</div>
				<!-- in-flow press logo marquee -->
				// <div class="marquee thin bleed" data-reveal style="margin-top:12px;border-bottom:none;background:var(--ink);color:var(--lime)">
				// 	<div class="track">
				// 		<span>Noise Quarterly</span><span class="s">&#10022;</span><span>Pixel Press</span><span class="s">&#10022;</span>
				// 		<span>Volt Mag</span><span class="s">&#10022;</span><span>Static Zine</span><span class="s">&#10022;</span><span>Hyperwave</span><span class="s">&#10022;</span>
				// 		<span>Noise Quarterly</span><span class="s">&#10022;</span><span>Pixel Press</span><span class="s">&#10022;</span>
				// 		<span>Volt Mag</span><span class="s">&#10022;</span><span>Static Zine</span><span class="s">&#10022;</span><span>Hyperwave</span><span class="s">&#10022;</span>
				// 	</div>
				// </div>
			</div>
		</section>
	}
}
