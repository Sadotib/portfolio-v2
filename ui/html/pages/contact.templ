package pages

import "portfolio-v2/ui/html"

templ Contact(day string) {
	@html.Base(day) {
		<!-- ============ SLIDE 6 : CONTACT ============ -->
		<section class="slide s-ink" data-slide="5">
			<div class="inner scrollable">
				<div class="wrap">
					// <span class="kicker hl-orange" data-reveal>08 / Contact</span>
					<h2 class="big hl-lime" data-reveal style="margin:6px 0 16px">Get in Touch</h2>
					<div class="contact-grid">
						<div class="cc" data-reveal><div class="v"><a href="mailto:bitopan21mbb@gmail.com">Email</a></div></div>
						<div class="cc" data-reveal><div class="v"><a href="https://github.com/Sadotib" target="_blank">Github</a></div></div>
						<div class="cc" data-reveal><div class="v"><a href="https://www.linkedin.com/in/bitopan-das-a21928254" target="_blank">LinkedIn</a></div></div>
						<div class="cc" data-reveal><div class="v"><a href="https://www.instagram.com/sadotib" target="_blank">Instagram</a></div></div>
					</div>
					// <div class="socials" data-reveal>
					// 	<span class="tag">hyprluv</span>
					// 	<span class="tag">hyprluv.fm</span>
					// 	<span class="tag">All platforms</span>
					// </div>
					// <div class="btnrow" data-reveal style="margin-top:18px">
					// 	<a class="btn fill" href="#">Download Full EPK</a>
					// 	<a class="btn" href="#">Stream Now</a>
					// </div>
				</div>
			</div>
		</section>
	}
}
