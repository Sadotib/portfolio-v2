package pages

import "portfolio-v2/ui/html"

templ About(day string) {
	@html.Base(day) {
		<!-- ============ SLIDE 2 : About ============ -->
		<section class="slide s-orange" data-slide="1">
			<div class="inner scrollable">
				<div class="wrap">
					// <span class="kicker" data-reveal>02 / Who</span>
					<h2 class="big" data-reveal style="margin:6px 0 16px">Who am I?</h2>
					<div class="bio-grid">
						<div data-reveal>
							<p class="lead" style="margin-bottom:14px">
								Hi, I am Bitopan Das, a developer with a background in Computer Science. I am from Assam, a state in North East India.
								I like working with backend stuff (probably because i suck at design, this site is a testament to that).
							</p>
							<p class="lead">
								When I am not scratching my head over some code, you can find me playing games, at the gym or just reading some random stuff on the internet.
								<br/>
								I am currently working as a GET at VOIS.
								
							</p>
							<p class="lead">
								<br/>
								<a href="resume.pdf" target="_blank" style="font-size: large; color: var(--lime); font-weight: bold;">Resume ↗</a>
							</p>
						</div>
						<div class="bio-meta" data-reveal>
							<div class="meta-card">
								<div class="k">Languages & Tools</div>
								// <div class="v">Bangkok / Everywhere</div>
								<div class="tags" style="margin-top:18px">
									<span class="tag">Go</span>
									<span class="tag">Python</span>
									<span class="tag">JavaScript</span>
									<span class="tag">Node.js</span>
									<span class="tag">Flutter</span>
									<span class="tag">AWS</span>
									<span class="tag">SQL</span>
									<span class="tag">SAP BTP</span>
									<span class="tag">SAP UI5</span>
									<span class="tag">CAPM</span>
									<span class="tag">Linux</span>
									<span class="tag">Git</span>
									<span class="tag">Github</span>
									// <span class="tag">Postman</span>
									
									
								</div>
								
							</div>
							
							
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}
